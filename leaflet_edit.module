<?php

/**
 * @file
 * Contains leaflet_edit.module.
 */

declare(strict_types=1);

use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\leaflet_edit\Plugin\Field\FieldFormatter\LeafletEditFormatter;
use Drupal\node\NodeInterface;

/**
 * Implements hook_help().
 */
function leaflet_edit_help(string $route_name, RouteMatchInterface $route_match): ?string {
  switch ($route_name) {
    case 'help.page.leaflet_edit':
      $output = '';
      $output .= '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('Display and edit GeoJSON files on a Leaflet map, with save and revision history.') . '</p>';
      return $output;

    default:
      return NULL;
  }
}

/**
 * Implements hook_theme().
 */
function leaflet_edit_theme(): array {
  return [
    'leaflet_edit' => [
      'variables' => [
        'map_id' => NULL,
        'height' => '400px',
        'map' => [],
      ],
      'template' => 'leaflet-edit',
    ],
  ];
}

/**
 * Implements hook_ENTITY_TYPE_create() for nodes.
 *
 * Snapshots the content type (Default view display) map settings into the
 * per-node override fields. Each new map therefore starts as an explicit,
 * editable copy of the globals instead of "empty = inherit", which could
 * never express "disable an inherited option" (e.g. uncheck a single tool).
 * Only empty fields are filled, so explicit programmatic values win, and
 * existing nodes (or still-empty fields) keep the historic dynamic
 * inheritance at render time.
 */
function leaflet_edit_node_create(NodeInterface $node): void {
  if ($node->bundle() !== 'leaflet_map_editor') {
    return;
  }
  _leaflet_edit_snapshot_display_settings($node);
}

/**
 * Copies the Default display map settings into empty per-node fields.
 *
 * @param \Drupal\node\NodeInterface $node
 *   The new (unsaved) leaflet_map_editor node.
 */
function _leaflet_edit_snapshot_display_settings(NodeInterface $node): void {
  // Single source of truth: the leaflet_edit_formatter settings on the
  // bundle Default display. Fall back to the formatter defaults when the
  // component is missing or misconfigured.
  $settings = [];
  try {
    $display = \Drupal::entityTypeManager()
      ->getStorage('entity_view_display')
      ->load('node.leaflet_map_editor.default');
    $component = $display ? $display->getComponent('field_geofile_traces') : NULL;
    if (is_array($component)
      && ($component['type'] ?? '') === 'leaflet_edit_formatter'
      && isset($component['settings']) && is_array($component['settings'])) {
      $settings = $component['settings'];
    }
  }
  catch (\Exception) {
    $settings = [];
  }
  if ($settings === []) {
    $settings = LeafletEditFormatter::defaultSettings();
  }

  // 1. Basemap: copy only known map keys (a stale display key stays empty
  // and falls back at render time instead of propagating staleness).
  if ($node->hasField(LeafletEditFormatter::BASEMAP_FIELD)
    && $node->get(LeafletEditFormatter::BASEMAP_FIELD)->isEmpty()) {
    $map_key = trim((string) ($settings['leaflet_map'] ?? ''));
    if ($map_key !== ''
      && function_exists('leaflet_map_get_info')
      && isset(leaflet_map_get_info()[$map_key])) {
      $node->set(LeafletEditFormatter::BASEMAP_FIELD, $map_key);
    }
  }

  // 2. Tools: explicit enabled set (mirrors resolveNodeOverrides(): unknown
  // IDs are dropped, '_none' alone means "no optional tool").
  if ($node->hasField(LeafletEditFormatter::TOOLS_FIELD)
    && $node->get(LeafletEditFormatter::TOOLS_FIELD)->isEmpty()) {
    $tools = $settings['leaflet_edit']['tools'] ?? NULL;
    if (!is_array($tools)) {
      $defaults = LeafletEditFormatter::defaultSettings();
      $tools = $defaults['leaflet_edit']['tools'] ?? [];
    }
    $known = array_keys(LeafletEditFormatter::toolLibraryMap());
    $enabled = array_values(array_intersect($known, array_keys(array_filter($tools))));
    if ($enabled !== []) {
      $node->set(LeafletEditFormatter::TOOLS_FIELD, $enabled);
    }
    elseif (array_filter($tools) === []) {
      // Display enables nothing: snapshot "no optional tool" explicitly so
      // the node does not silently re-enable tools later.
      $node->set(LeafletEditFormatter::TOOLS_FIELD, ['_none']);
    }
    // Otherwise the display only holds unknown (legacy) IDs: leave empty
    // and inherit dynamically, exactly as the renderer would.
  }

  // 3. Control positions.
  $valid_positions = ['topleft', 'topright', 'bottomleft', 'bottomright'];
  foreach ([
    LeafletEditFormatter::GEOMAN_POS_FIELD => ['geoman', 'position'],
    LeafletEditFormatter::LOCATE_POS_FIELD => ['locatecontrol', 'position'],
  ] as $field_name => [$section, $key]) {
    if (!$node->hasField($field_name) || !$node->get($field_name)->isEmpty()) {
      continue;
    }
    $position = trim((string) ($settings['leaflet_edit'][$section][$key] ?? ''));
    if (in_array($position, $valid_positions, TRUE)) {
      $node->set($field_name, $position);
    }
  }
}

/**
 * Allowed values callback for the field_leaflet_basemap field storage.
 *
 * Returns every map definition from hook_leaflet_map_info() (key => label)
 * so the node-level override always offers the current basemaps, including
 * leaflet_more_maps custom maps (e.g. "~Cartes Topo"). The empty value is
 * handled by the widget itself ("- None -" = use the display default).
 *
 * @param \Drupal\Core\Field\FieldStorageDefinitionInterface $definition
 *   The field storage definition.
 * @param \Drupal\Core\Entity\FieldableEntityInterface|null $entity
 *   (optional) The entity being edited, if any.
 * @param bool|null $cacheable
 *   (optional) Set to FALSE: map definitions depend on configuration
 *   (leaflet_more_maps.settings) and must not be statically cached.
 *
 * @return array<string, string>
 *   Map keys mapped to human labels.
 */
function leaflet_edit_basemap_allowed_values($definition, $entity = NULL, &$cacheable = NULL): array {
  $cacheable = FALSE;
  $options = [];
  foreach (leaflet_map_get_info() as $key => $map) {
    $options[$key] = $map['label'] ?? $key;
  }
  natcasesort($options);
  return $options;
}
